@model BlogRequest

@{
    var containerDivClass = "container";
    ViewData["Title"] = "Blog Create";
}
<div class="@containerDivClass">
    <h1>@ViewData["Title"]</h1>
    <hr />
    <form asp-action="Create" method="post" autocomplete="off">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="text-danger"></div>
        <div class="row mb-3">
            <label asp-for="Title" class="col-2 col-form-label fw-bold"></label>
            <div class="col-10">
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>
        </div>
        <div class="row mb-3">
            <label asp-for="Content" class="col-2 col-form-label fw-bold"></label>
            <div class="col-10">
                <textarea asp-for="Content" class="form-control" rows="5"></textarea>
                <span asp-validation-for="Content" class="text-danger"></span>
            </div>
        </div>
        <div class="row mb-3">
            <label asp-for="Rating" class="col-2 col-form-label fw-bold"></label>
            <div class="col-10 position-relative">
                <input asp-for="Rating" class="form-control" />
                <span class="position-absolute opacity-25 me-3" style="right: 12px; top: 4px;"> /10</span>
                <span asp-validation-for="Rating" class="text-danger"></span>
            </div>
        </div>
        <div class="row mb-3">
            <label asp-for="PublishDate" class="col-2 col-form-label fw-bold"></label>
            <div class="col-10">
                <input type="date" asp-for="PublishDate" class="form-control datetimepicker"/>
                <span asp-validation-for="PublishDate" class="text-danger"></span>
            </div>
        </div>
        <div class="row mb-3">
            <label asp-for="IsArchived" class="col-2 col-form-label fw-bold"></label>
            <div class="col-10">
                <input asp-for="IsArchived" class="form-check-input" />
                <span asp-validation-for="IsArchived" class="text-danger"></span>
            </div>
        </div>
        <div class="row mb-3">
            <label asp-for="UserName" class="col-2 col-form-label fw-bold"></label>
            <div class="col-10">
                <input asp-for="UserName" class="form-control" />
                <span asp-validation-for="UserName" class="text-danger"></span>
            </div>
        </div>
        <div class="row mb-3">
            <label asp-for="UserId" class="col-2 col-form-label fw-bold"></label>
            <div class="col-10">
                <input asp-for="UserId" class="form-control" />
                <span asp-validation-for="UserId" class="text-danger"></span>
            </div>
        </div>
        <div class="row mb-3">
            <label asp-for="TagIds" class="col-2 col-form-label fw-bold"></label>
            <div class="col-10">
                <select multiple asp-for="TagIds" class="form-select" asp-items="ViewBag.TagIds"></select>
                <span asp-validation-for="TagIds" class="text-danger"></span>
            </div>
        </div>
        <hr />
        <div class="row mb-3">
            <div class="offset-2 col-10">
                <button type="submit" class="btn btn-primary">Save</button>
                &nbsp;&nbsp;
                <button type="reset" class="btn btn-outline-primary">Reset</button>
                &nbsp;&nbsp;
                <a asp-action="Index">Back to List</a>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <link href="~/lib/jquery-datetimepicker/jquery.datetimepicker.min.css" rel="stylesheet" />
    <script src="~/lib/jquery-datetimepicker/jquery.datetimepicker.full.min.js"></script>
    <script>
        $(function () {
            $(".datetimepicker").datetimepicker({
                timepicker: true,
                format: 'm/d/Y H:i'
            });
        });
    </script>
}
