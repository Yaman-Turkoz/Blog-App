@model IEnumerable<APP.Models.BlogResponse>

@{
    var containerDivClass = "container-fluid";
    ViewData["Title"] = "Blogs";
}
<div class="@containerDivClass">
    <h1>@ViewData["Title"]</h1>
    <hr />
    @if (TempData["Message"] is not null)
    {
        <p class="text-danger">@TempData["Message"]</p>
    }
</div>
@if (Model is not null)
{
<div class="@containerDivClass">
    <div class="row mb-3">
        <div class="col-10">@Model.Count() record(s) found.</div>
        <div class="col-2 text-end"><a asp-action="Create">Create</a></div>
    </div>
    <table class="table table-striped table-hover">
        <thead class="table-secondary">
            <tr>
                <th>@Html.DisplayNameFor(model => model.Title)</th>
                <th>@Html.DisplayNameFor(model => model.Content)</th>
                <th>@Html.DisplayNameFor(model => model.RatingR)</th>
                <th>@Html.DisplayNameFor(model => model.PublishDateR)</th>
                <th>@Html.DisplayNameFor(model => model.IsArchivedR)</th>
                <th>@Html.DisplayNameFor(model => model.UserName)</th>
                <th>@Html.DisplayNameFor(model => model.UserId)</th>
                <th>@Html.DisplayNameFor(model => model.TagNamesR)</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(model => item.Title)</td>
                <td>@Html.DisplayFor(model => item.Content)</td>
                <td>@Html.DisplayFor(model => item.RatingR)</td>
                <td>@Html.DisplayFor(model => item.PublishDateR)</td>
                <td>@Html.DisplayFor(model => item.IsArchivedR)</td>
                <td>@Html.DisplayFor(model => item.UserName)</td>
                <td>@Html.DisplayFor(model => item.UserId)</td>
                <td>@Html.DisplayFor(model => item.TagNamesR)</td>
                <td class="text-end w-25">
                    <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                    <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
}
