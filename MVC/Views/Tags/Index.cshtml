@model IEnumerable<TagResponse>

@{
    var containerDivClass = "container-fluid";
    ViewData["Title"] = "Tags";
}
<div class="@containerDivClass">
    <h1>@ViewData["Title"]</h1>
    <hr />
    @if (TempData["Message"] is not null)
    {
        <p class="text-danger">@TempData["Message"]</p>
    }
</div>
@if (Model is not null)
{
    <div class="@containerDivClass">
        <div class="row mb-3">
            <div class="col-10">@Model.Count() record(s) found.</div>
            <div class="col-2 text-end"><a asp-action="Create">Create</a></div>
        </div>
        <table class="table table-striped table-hover">
            <thead class="table-secondary">
            <tr>
                <th>@Html.DisplayNameFor(model => model.Name)</th>
                <th>@Html.DisplayNameFor(model => model.BlogCountR)</th>
                <th>@Html.DisplayNameFor(model => model.BlogTitlesR)</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(model => item.Name)</td>
                    <td>@Html.DisplayFor(model => item.BlogCountR)</td>
                    <td>@Html.DisplayFor(model => item.BlogTitlesR)</td>
                    <td class="text-end w-25">
                        <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                        <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                        <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}